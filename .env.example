# Required web values
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_local_example
APP_ORIGIN=http://localhost:3000
APP_ENV=local

# Optional application defaults
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR
DEMO_SEED=solarshare-demo-v1

# Worker and task values
TASKS_ENABLED=false
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SOLARSHARE_DEMO_PASSWORD=
TRIGGER_PROJECT_REF=
TRIGGER_SECRET_KEY=

# Optional provider values
OPEN_METEO_BASE_URL=
OPEN_METEO_API_KEY=
PVGIS_BASE_URL=
PVGIS_API_KEY=
GEOCODING_BASE_URL=
GEOCODING_API_KEY=

# Optional internal job route value
INTERNAL_JOB_SECRET=

# Optional telemetry values
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=solarshare-web
