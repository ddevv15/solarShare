{
  "name": "solarshare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "dotenv -e .env.example -- next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "pnpm db:start:local",
    "db:start:local": "supabase start",
    "db:reset": "pnpm db:reset:local",
    "db:reset:local": "supabase db reset --local",
    "db:types": "pnpm db:types:local",
    "db:types:local": "supabase gen types typescript --local --schema public > src/types/database.generated.ts",
    "db:push:linked": "supabase db push --linked",
    "db:types:linked": "supabase gen types typescript --linked --schema public > src/types/database.generated.ts",
    "db:activate-demo-users": "dotenv -e .env.local -- tsx scripts/activate-demo-users.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build:check"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "10.23.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/server": "^1.6.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.23.0"
}
